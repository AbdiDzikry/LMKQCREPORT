{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "/(css|js|images|favicon.ico|robots.txt)(.*)",
            "dest": "/public/$1$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://lmkqcreport.vercel.app",
        "APP_KEY": "base64:o2R/uWsaSdrUkZ/QGV1rt2qJBFppK9MwQzEVjxGvsHY=",
        "DB_CONNECTION": "pgsql",
        "SESSION_DRIVER": "cookie",
        "BCRYPT_ROUNDS": "10",
        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr"
    }
}
